# Copy to .env — .env is git-ignored, this file is committed.
CIRCULO_ENVIRONMENT=development
CIRCULO_API_PREFIX=/api

# Absolute or relative path to the SQLite file (Phase 2 seeds it)
CIRCULO_DATABASE_PATH=app/database/circulo.db

# ── LLM: OFF BY DEFAULT. The Golden Path must never require it. ────────────
CIRCULO_LLM_ENABLED=false
CIRCULO_LLM_API_KEY=
CIRCULO_LLM_TIMEOUT_SECONDS=8.0

# Hard kill-switch for demo day: forces every agent down its deterministic
# path regardless of any other setting.
CIRCULO_DETERMINISTIC_MODE=true

# JSON array — Vite dev server default
CIRCULO_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]